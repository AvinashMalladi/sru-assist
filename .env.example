# Copy this file to .env and fill in your keys.

# Required - OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Model id from https://openrouter.ai/models (free ids end with :free)
# LATENCY: the default free model is SLOW (~5 tok/s). For ~2-3s answers pick a
# faster id here, e.g. a smaller/faster model from OpenRouter, then verify
# quality with: python scripts/run_eval.py --full
MODEL_NAME=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional - Tavily web search fallback (https://tavily.com)
TAVILY_API_KEY=

# Set to false to force handbook-only answers
ENABLE_WEB_SEARCH=true

# --- latency knobs (see README "Reducing latency") ---
# fast (default): exactly ONE LLM call per question (tools skipped).
# agent: full multi-step tool loop (AGENT_MAX_STEPS rounds, slower).
AGENT_MODE=fast
# Agent loop cap when AGENT_MODE=agent.
AGENT_MAX_STEPS=4
# Handbook chunks injected into the prompt. Lower = smaller prompt = faster.
AUTO_CONTEXT_TOP_K=4
# Completion token cap per answer (answers that stop sooner finish sooner).
MAX_TOKENS=700
# Max seconds a single LLM call may take before it is treated as failed.
LLM_TIMEOUT=90

# --- portal content sync (see docs/PORTAL_INTEGRATION.md) ---
# If set, POST /api/sync requires Authorization: Bearer <value>.
SYNC_TOKEN=

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# FLASK_PORT=5000
